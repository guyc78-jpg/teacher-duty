{
  "name": "ArrivalConfirmation",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string",
      "title": "\u05e9\u05d9\u05d1\u05d5\u05e5"
    },
    "teacher_id": {
      "type": "string",
      "title": "\u05de\u05d5\u05e8\u05d4"
    },
    "teacher_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05d5\u05e8\u05d4"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "title": "\u05d7\u05d5\u05ea\u05de\u05ea \u05d6\u05de\u05df"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "on_time",
        "late"
      ],
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1",
      "default": "pending"
    },
    "updated_by": {
      "type": "string",
      "title": "\u05de\u05d9 \u05e2\u05d3\u05db\u05df"
    },
    "updated_by_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05e2\u05d3\u05db\u05df"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "break_type": {
      "type": "string",
      "enum": [
        "big",
        "medium",
        "small"
      ],
      "title": "\u05e1\u05d5\u05d2 \u05d4\u05e4\u05e1\u05e7\u05d4"
    },
    "station_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e2\u05de\u05d3\u05d4"
    }
  },
  "required": [
    "assignment_id",
    "teacher_id"
  ],
  "access": {
    "read": "all_authenticated",
    "create": "all_authenticated",
    "update": "all_authenticated",
    "delete": "admin"
  }
}