      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "day_of_week": {
      "type": "number",
      "title": "\u05d9\u05d5\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2 (0=\u05e8\u05d0\u05e9\u05d5\u05df)"
    },
    "break_type": {
      "type": "string",
      "enum": [
        "big",
        "medium",
        "small"
      ],
      "title": "\u05e1\u05d5\u05d2 \u05d4\u05e4\u05e1\u05e7\u05d4"
    },
    "station_id": {
      "type": "string",
      "title": "\u05e2\u05de\u05d3\u05d4"
    },
    "station_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e2\u05de\u05d3\u05d4"
    },
    "teacher_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "\u05de\u05d5\u05e8\u05d9\u05dd"
    },
    "teacher_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "\u05e9\u05de\u05d5\u05ea \u05de\u05d5\u05e8\u05d9\u05dd"
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "swap",
        "absence",
        "special"
      ],
      "default": "manual",
      "title": "\u05de\u05e7\u05d5\u05e8"
    },
    "reason": {
      "type": "string",
      "title": "\u05e1\u05d9\u05d1\u05d4"
    }
  },
  "required": [
    "date",
    "break_type",
    "station_id"
  ],
  "access": {
    "read": "all_authenticated",
