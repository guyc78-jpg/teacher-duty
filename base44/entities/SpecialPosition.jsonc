{
  "name": "SpecialPosition",
  "type": "object",
  "properties": {
    "special_day_id": {
      "type": "string",
      "title": "\u05d9\u05d5\u05dd \u05de\u05d9\u05d5\u05d7\u05d3"
    },
    "name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e2\u05de\u05d3\u05d4"
    },
    "area": {
      "type": "string",
      "title": "\u05d0\u05d6\u05d5\u05e8"
    },
    "instructions": {
      "type": "string",
      "title": "\u05d4\u05e0\u05d7\u05d9\u05d5\u05ea"
    },
    "restriction_type": {
      "type": "string",
      "enum": [
        "all",
        "management",
        "sport",
        "division",
        "group"
      ],
      "default": "all",
      "title": "\u05de\u05d2\u05d1\u05dc\u05ea \u05ea\u05e4\u05e7\u05d9\u05d3"
    },
    "division": {
      "type": "string",
      "enum": [
        "middle",
        "high",
        "both"
      ],
      "title": "\u05d7\u05d8\u05d9\u05d1\u05d4"
    },
    "allowed_teacher_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "title": "\u05e7\u05d1\u05d5\u05e6\u05ea \u05de\u05d5\u05e8\u05d9\u05dd"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "title": "\u05e4\u05e2\u05d9\u05dc\u05d4"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "\u05e1\u05d3\u05e8"
    }
  },
  "required": [
    "special_day_id",
    "name"
  ],
  "access": {
    "read": "admin",
    "create": "admin",
    "update": "admin",
    "delete": "admin"
  }
}