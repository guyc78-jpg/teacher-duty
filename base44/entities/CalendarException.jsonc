{
  "name": "CalendarException",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05d7\u05e8\u05d9\u05d2"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "type": {
      "type": "string",
      "enum": [
        "no_school",
        "short_day",
        "exam",
        "trip",
        "weather",
        "special_event",
        "break_change"
      ],
      "title": "\u05e1\u05d5\u05d2",
      "default": "no_school"
    },
    "description": {
      "type": "string",
      "title": "\u05ea\u05d9\u05d0\u05d5\u05e8"
    },
    "alternative_breaks": {
      "type": "object",
      "title": "\u05d4\u05e4\u05e1\u05e7\u05d5\u05ea \u05d7\u05dc\u05d5\u05e4\u05d9\u05d5\u05ea"
    },
    "alternative_stations": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "\u05e2\u05de\u05d3\u05d5\u05ea \u05d7\u05dc\u05d5\u05e4\u05d9\u05d5\u05ea"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "title": "\u05e4\u05e2\u05d9\u05dc"
    }
  },
  "required": [
    "name",
    "date",
    "type"
  ],
  "access": {
    "read": "all_authenticated",
    "create": "admin",
    "update": "admin",
    "delete": "admin"
  }
}