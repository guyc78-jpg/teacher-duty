{
  "name": "SwapRequest",
  "type": "object",
  "properties": {
    "assignment_id": {
      "type": "string",
      "title": "\u05e9\u05d9\u05d1\u05d5\u05e5 \u05de\u05e7\u05d5\u05e8 (\u05d9\u05e9\u05df)"
    },
    "initiator_id": {
      "type": "string",
      "title": "\u05d9\u05d5\u05d6\u05dd"
    },
    "initiator_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d9\u05d5\u05d6\u05dd"
    },
    "swap_type": {
      "type": "string",
      "enum": [
        "mutual",
        "takeover"
      ],
      "title": "\u05e1\u05d5\u05d2 \u05d4\u05d7\u05dc\u05e4\u05d4",
      "default": "takeover"
    },
    "target_teacher_id": {
      "type": "string",
      "title": "\u05de\u05d5\u05e8\u05d4 \u05d9\u05e2\u05d3"
    },
    "target_teacher_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05d5\u05e8\u05d4 \u05d9\u05e2\u05d3"
    },
    "is_open": {
      "type": "boolean",
      "default": true,
      "title": "\u05d1\u05e7\u05e9\u05d4 \u05e4\u05ea\u05d5\u05d7\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "cancelled",
        "expired"
      ],
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1",
      "default": "pending"
    },
    "valid_until": {
      "type": "string",
      "title": "\u05ea\u05d5\u05e7\u05e3"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "title": "\u05d6\u05de\u05df \u05d9\u05e6\u05d9\u05e8\u05d4"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "title": "\u05d6\u05de\u05df \u05d0\u05d9\u05e9\u05d5\u05e8"
    },
    "accepted_by_id": {
      "type": "string",
      "title": "\u05de\u05d0\u05e9\u05e8"
    },
    "accepted_by_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05d0\u05e9\u05e8"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05d5\u05e8\u05e0\u05d5\u05ea"
    },
    "day_of_week": {
      "type": "number",
      "title": "\u05d9\u05d5\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2"
    },
    "break_type": {
      "type": "string",
      "enum": [
        "big",
        "medium",
        "small"
      ],
      "title": "\u05e1\u05d5\u05d2 \u05d4\u05e4\u05e1\u05e7\u05d4"
    },
    "break_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05e4\u05e1\u05e7\u05d4"
    },
    "station_id": {
      "type": "string",
      "title": "\u05e2\u05de\u05d3\u05d4"
    },
    "station_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e2\u05de\u05d3\u05d4"
    },
    "start_time": {
      "type": "string",
      "title": "\u05e9\u05e2\u05ea \u05d4\u05ea\u05d7\u05dc\u05d4"
    },
    "end_time": {
      "type": "string",
      "title": "\u05e9\u05e2\u05ea \u05e1\u05d9\u05d5\u05dd"
    },
    "offered_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05ea\u05d5\u05e8\u05e0\u05d5\u05ea \u05de\u05d5\u05e6\u05e2\u05ea"
    },
    "offered_break_type": {
      "type": "string",
      "enum": [
        "big",
        "medium",
        "small"
      ],
      "title": "\u05e1\u05d5\u05d2 \u05d4\u05e4\u05e1\u05e7\u05d4 \u05de\u05d5\u05e6\u05e2\u05ea"
    },
    "offered_break_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05e4\u05e1\u05e7\u05d4 \u05de\u05d5\u05e6\u05e2\u05ea"
    },
    "offered_station_id": {
      "type": "string",
      "title": "\u05e2\u05de\u05d3\u05d4 \u05de\u05d5\u05e6\u05e2\u05ea"
    },
    "offered_station_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e2\u05de\u05d3\u05d4 \u05de\u05d5\u05e6\u05e2\u05ea"
    },
    "offered_start_time": {
      "type": "string",
      "title": "\u05e9\u05e2\u05ea \u05d4\u05ea\u05d7\u05dc\u05d4 \u05de\u05d5\u05e6\u05e2\u05ea"
    },
    "offered_end_time": {
      "type": "string",
      "title": "\u05e9\u05e2\u05ea \u05e1\u05d9\u05d5\u05dd \u05de\u05d5\u05e6\u05e2\u05ea"
    }
  },
  "required": [
    "initiator_id",
    "swap_type",
    "date",
    "break_type",
    "station_id"
  ],
  "access": {
    "read": "all_authenticated",
    "create": "admin",
    "update": "admin",
    "delete": "admin"
  }
}