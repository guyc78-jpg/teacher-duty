{
  "name": "IncidentReport",
  "type": "object",
  "properties": {
    "reporter_id": {
      "type": "string",
      "title": "\u05de\u05d3\u05d5\u05d5\u05d7"
    },
    "reporter_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05d3\u05d5\u05d5\u05d7"
    },
    "assignment_id": {
      "type": "string",
      "title": "\u05e9\u05d9\u05d1\u05d5\u05e5"
    },
    "station_id": {
      "type": "string",
      "title": "\u05e2\u05de\u05d3\u05d4"
    },
    "station_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e2\u05de\u05d3\u05d4"
    },
    "category": {
      "type": "string",
      "enum": [
        "violence",
        "vandalism",
        "smoking",
        "injury",
        "other"
      ],
      "title": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4",
      "default": "other"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "\u05d3\u05e8\u05d2\u05ea \u05d7\u05d5\u05de\u05e8\u05d4",
      "default": "low"
    },
    "description": {
      "type": "string",
      "title": "\u05ea\u05d9\u05d0\u05d5\u05e8"
    },
    "image_url": {
      "type": "string",
      "title": "\u05ea\u05de\u05d5\u05e0\u05d4"
    },
    "event_time": {
      "type": "string",
      "format": "date-time",
      "title": "\u05d6\u05de\u05df \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved"
      ],
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d8\u05d9\u05e4\u05d5\u05dc",
      "default": "open"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da"
    }
  },
  "required": [
    "reporter_id",
    "category",
    "severity",
    "description"
  ],
  "access": {
    "read": "admin_coordinator",
    "create": "all_authenticated",
    "update": "admin",
    "delete": "admin"
  }
}