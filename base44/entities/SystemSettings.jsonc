{
  "name": "SystemSettings",
  "type": "object",
  "properties": {
    "school_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d1\u05d9\u05ea \u05d4\u05e1\u05e4\u05e8",
      "default": "\u05d1\u05d9\u05ea \u05e1\u05e4\u05e8 \u05ea\u05d9\u05db\u05d5\u05df"
    },
    "timezone": {
      "type": "string",
      "title": "\u05d0\u05d6\u05d5\u05e8 \u05d6\u05de\u05df",
      "default": "Asia/Jerusalem"
    },
    "morning_reminder_time": {
      "type": "string",
      "title": "\u05e9\u05e2\u05ea \u05ea\u05d6\u05db\u05d5\u05e8\u05ea \u05d1\u05d5\u05e7\u05e8",
      "default": "08:00"
    },
    "pre_duty_reminder_minutes": {
      "type": "number",
      "title": "\u05d3\u05e7\u05d5\u05ea \u05dc\u05e4\u05e0\u05d9 \u05ea\u05d5\u05e8\u05e0\u05d5\u05ea",
      "default": 10
    },
    "missing_arrival_threshold_minutes": {
      "type": "number",
      "title": "\u05d3\u05e7\u05d5\u05ea \u05dc\u05d0\u05d9\u05ea\u05d5\u05e8 \u05d0\u05d9\u05be\u05d0\u05d9\u05e9\u05d5\u05e8",
      "default": 5
    },
    "security_coordinator_phone": {
      "type": "string",
      "title": "\u05d8\u05dc\u05e4\u05d5\u05df \u05e8\u05db\u05d6 \u05d1\u05d9\u05d8\u05d7\u05d5\u05df"
    },
    "school_contact_phone": {
      "type": "string",
      "title": "\u05d8\u05dc\u05e4\u05d5\u05df \u05d1\u05d9\u05ea \u05e1\u05e4\u05e8"
    },
    "rain_mode_stations": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "\u05e2\u05de\u05d3\u05d5\u05ea \u05de\u05e6\u05d1 \u05d2\u05e9\u05dd"
    },
    "pilot_mode_enabled": {
      "type": "boolean",
      "default": false,
      "title": "\u05de\u05e6\u05d1 \u05d4\u05e8\u05e6\u05d4"
    },
    "pilot_teacher_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u05de\u05d5\u05e8\u05d9 \u05d4\u05e8\u05e6\u05d4"
    },
    "fixed_quota_policy": {
      "type": "string",
      "enum": [
        "warning",
        "block"
      ],
      "default": "warning",
      "title": "\u05de\u05d3\u05d9\u05e0\u05d9\u05d5\u05ea \u05d7\u05e8\u05d9\u05d2\u05d5\u05ea \u05de\u05db\u05e1\u05d4 \u05d1\u05dc\u05d5\u05d7 \u05e7\u05d1\u05d5\u05e2"
    }
  },
  "required": [
    "school_name"
  ],
  "access": {
    "read": "all_authenticated",
    "create": "admin",
    "update": "admin",
    "delete": "admin"
  }
}