{
  "name": "DutyRule",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05db\u05dc\u05dc"
    },
    "min_hours": {
      "type": "number",
      "title": "\u05e9\u05e2\u05d5\u05ea \u05de\u05d9\u05e0\u05d9\u05de\u05d5\u05dd"
    },
    "max_hours": {
      "type": "number",
      "title": "\u05e9\u05e2\u05d5\u05ea \u05de\u05e7\u05e1\u05d9\u05de\u05d5\u05dd"
    },
    "big_count": {
      "type": "number",
      "default": 0,
      "title": "\u05de\u05e1\u05e4\u05e8 \u05ea\u05d5\u05e8\u05e0\u05d5\u05d9\u05d5\u05ea \u05d2\u05d3\u05d5\u05dc\u05d5\u05ea"
    },
    "medium_count": {
      "type": "number",
      "default": 0,
      "title": "\u05de\u05e1\u05e4\u05e8 \u05ea\u05d5\u05e8\u05e0\u05d5\u05d9\u05d5\u05ea \u05d1\u05d9\u05e0\u05d5\u05e0\u05d9\u05d5\u05ea"
    },
    "small_count": {
      "type": "number",
      "default": 0,
      "title": "\u05de\u05e1\u05e4\u05e8 \u05ea\u05d5\u05e8\u05e0\u05d5\u05d9\u05d5\u05ea \u05e7\u05d8\u05e0\u05d5\u05ea"
    },
    "valid_from": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05db\u05e0\u05d9\u05e1\u05d4 \u05dc\u05ea\u05d5\u05e7\u05e3"
    },
    "valid_until": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "title": "\u05e4\u05e2\u05d9\u05dc"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "title": "\u05e1\u05d3\u05e8 \u05ea\u05e6\u05d5\u05d2\u05d4"
    }
  },
  "required": [
    "name",
    "min_hours",
    "max_hours"
  ],
  "access": {
    "read": "all_authenticated",
    "create": "admin",
    "update": "admin",
    "delete": "admin"
  }
}