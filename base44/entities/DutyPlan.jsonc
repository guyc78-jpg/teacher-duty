{
  "name": "DutyPlan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05ea\u05d5\u05db\u05e0\u05d9\u05ea"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05d7\u05dc\u05d4"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e1\u05d9\u05d5\u05dd"
    },
    "version": {
      "type": "number",
      "default": 1,
      "title": "\u05d2\u05e8\u05e1\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1",
      "default": "draft"
    },
    "is_management": {
      "type": "boolean",
      "default": false,
      "title": "\u05dc\u05d5\u05d7 \u05ea\u05d5\u05e8\u05e0\u05d5\u05ea \u05d4\u05e0\u05d4\u05dc\u05d4"
    },
    "created_by": {
      "type": "string",
      "title": "\u05d9\u05d5\u05e6\u05e8"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e4\u05e8\u05e1\u05d5\u05dd"
    },
    "notes": {
      "type": "string",
      "title": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "name",
    "start_date",
    "end_date"
  ],
  "access": {
    "read": "all_authenticated",
    "create": "admin",
    "update": "admin",
    "delete": "admin"
  }
}