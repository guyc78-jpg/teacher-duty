{
  "name": "SpecialAssignment",
  "type": "object",
  "properties": {
    "special_day_id": {
      "type": "string",
      "title": "\u05d9\u05d5\u05dd \u05de\u05d9\u05d5\u05d7\u05d3"
    },
    "special_day_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "time_slot_id": {
      "type": "string",
      "title": "\u05de\u05e7\u05d8\u05e2 \u05d6\u05de\u05df"
    },
    "time_slot_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05e7\u05d8\u05e2"
    },
    "start_time": {
      "type": "string",
      "title": "\u05e9\u05e2\u05ea \u05d4\u05ea\u05d7\u05dc\u05d4"
    },
    "end_time": {
      "type": "string",
      "title": "\u05e9\u05e2\u05ea \u05e1\u05d9\u05d5\u05dd"
    },
    "position_id": {
      "type": "string",
      "title": "\u05e2\u05de\u05d3\u05d4"
    },
    "position_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e2\u05de\u05d3\u05d4"
    },
    "position_instructions": {
      "type": "string",
      "title": "\u05d4\u05e0\u05d7\u05d9\u05d5\u05ea \u05e2\u05de\u05d3\u05d4"
    },
    "teacher_id": {
      "type": "string",
      "title": "\u05de\u05d5\u05e8\u05d4"
    },
    "teacher_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05d5\u05e8\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "confirmed",
        "completed",
        "cancelled"
      ],
      "default": "scheduled",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "source": {
      "type": "string",
      "enum": [
        "smart",
        "manual"
      ],
      "default": "manual",
      "title": "\u05de\u05e7\u05d5\u05e8"
    },
    "plan_status": {
      "type": "string",
      "enum": [
        "saved",
        "published"
      ],
      "default": "saved",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05dc\u05d5\u05d7"
    }
  },
  "required": [
    "special_day_id",
    "time_slot_id",
    "position_id",
    "teacher_id"
  ],
  "access": {
    "read": "admin",
    "create": "admin",
    "update": "admin",
    "delete": "admin"
  }
}