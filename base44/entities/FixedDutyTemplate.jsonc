{
  "name": "FixedDutyTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05ea\u05d1\u05e0\u05d9\u05ea",
      "default": "\u05dc\u05d5\u05d7 \u05ea\u05d5\u05e8\u05e0\u05d5\u05d9\u05d5\u05ea \u05e7\u05d1\u05d5\u05e2"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft",
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "version": {
      "type": "number",
      "default": 1,
      "title": "\u05d2\u05e8\u05e1\u05d4"
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "title": "\u05e9\u05d9\u05d1\u05d5\u05e6\u05d9 \u05d8\u05d9\u05d5\u05d8\u05d4"
    },
    "published_assignments": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "title": "\u05e9\u05d9\u05d1\u05d5\u05e6\u05d9\u05dd \u05e4\u05e2\u05d9\u05dc\u05d9\u05dd"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "title": "\u05e4\u05d5\u05e8\u05e1\u05dd \u05d1\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "published_by": {
      "type": "string",
      "title": "\u05e4\u05d5\u05e8\u05e1\u05dd \u05e2\u05dc \u05d9\u05d3\u05d9"
    },
    "last_override_reason": {
      "type": "string",
      "title": "\u05e1\u05d9\u05d1\u05ea \u05d7\u05e8\u05d9\u05d2\u05d4 \u05d0\u05d7\u05e8\u05d5\u05e0\u05d4"
    }
  },
  "required": [
    "name"
  ],
  "access": {
    "read": "admin",
    "create": "admin",
    "update": "admin",
    "delete": "admin"
  }
}