{
  "name": "ProfileChangeRequest",
  "type": "object",
  "properties": {
    "teacher_id": {
      "type": "string",
      "title": "\u05de\u05d5\u05e8\u05d4"
    },
    "teacher_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05d5\u05e8\u05d4"
    },
    "changes": {
      "type": "string",
      "title": "\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05de\u05d1\u05d5\u05e7\u05e9\u05d9\u05dd (JSON)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1",
      "default": "pending"
    },
    "reviewed_by": {
      "type": "string",
      "title": "\u05e0\u05d1\u05d3\u05e7 \u05e2\u05f4\u05d9"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time",
      "title": "\u05d6\u05de\u05df \u05d1\u05d3\u05d9\u05e7\u05d4"
    }
  },
  "required": [
    "teacher_id",
    "changes"
  ],
  "access": {
    "read": "all_authenticated",
    "create": "admin",
    "update": "admin",
    "delete": "admin"
  }
}