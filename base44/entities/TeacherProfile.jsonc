{
  "name": "TeacherProfile",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05dc\u05d0"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "\u05d3\u05d5\u05d0\u05f4\u05dc"
    },
    "employee_id": {
      "type": "string",
      "title": "\u05de\u05d6\u05d4\u05d4 \u05e2\u05d5\u05d1\u05d3"
    },
    "division": {
      "type": "string",
      "enum": [
        "middle",
        "high",
        "both"
      ],
      "title": "\u05d7\u05d8\u05d9\u05d1\u05d4",
      "default": "high"
    },
    "subject": {
      "type": "string",
      "title": "\u05de\u05e7\u05e6\u05d5\u05e2"
    },
    "additional_subjects": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u05de\u05e7\u05e6\u05d5\u05e2\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd",
      "default": []
    },
    "role": {
      "type": "string",
      "enum": [
        "management",
        "admin",
        "coordinator",
        "teacher",
        "homeroom"
      ],
      "title": "\u05ea\u05e4\u05e7\u05d9\u05d3 \u05de\u05e2\u05e8\u05db\u05ea",
      "default": "teacher"
    },
    "is_homeroom": {
      "type": "boolean",
      "title": "\u05de\u05d7\u05e0\u05da",
      "default": false
    },
    "homeroom_grade": {
      "type": "string",
      "title": "\u05e9\u05db\u05d1\u05d4"
    },
    "homeroom_class": {
      "type": "string",
      "title": "\u05db\u05d9\u05ea\u05d4"
    },
    "is_sport_teacher": {
      "type": "boolean",
      "title": "\u05de\u05d5\u05e8\u05d4 \u05dc\u05e1\u05e4\u05d5\u05e8\u05d8",
      "default": false
    },
    "weekly_teaching_hours": {
      "type": "number",
      "title": "\u05e9\u05e2\u05d5\u05ea \u05d4\u05d5\u05e8\u05d0\u05d4 \u05e9\u05d1\u05d5\u05e2\u05d9\u05d5\u05ea",
      "default": 0
    },
    "days_off": {
      "type": "array",
      "items": {
        "type": "number",
        "enum": [
          0,
          1,
          2,
          3,
          4
        ]
      },
      "title": "\u05d9\u05de\u05d9 \u05d7\u05d5\u05e4\u05e9 \u05e7\u05d1\u05d5\u05e2\u05d9\u05dd",
      "default": []
    },
    "busy_days": {
      "type": "array",
      "items": {
        "type": "number",
        "enum": [
          0,
          1,
          2,
          3,
          4
        ]
      },
      "title": "\u05d9\u05de\u05d9\u05dd \u05e2\u05de\u05d5\u05e1\u05d9\u05dd",
      "default": []
    },
    "is_active": {
      "type": "boolean",
      "title": "\u05e4\u05e2\u05d9\u05dc",
      "default": true
    },
    "is_exempt": {
      "type": "boolean",
      "title": "\u05e4\u05d8\u05d5\u05e8 \u05de\u05ea\u05d5\u05e8\u05e0\u05d5\u05ea",
      "default": false
    },
    "exemption_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "approved",
        "rejected"
      ],
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d1\u05e7\u05e9\u05ea \u05e4\u05d8\u05d5\u05e8",
      "default": "none"
    },
    "onboarding_completed": {
      "type": "boolean",
      "title": "\u05d4\u05e9\u05dc\u05d9\u05dd \u05e7\u05dc\u05d9\u05d8\u05d4",
      "default": false
    },
    "onboarding_step": {
      "type": "number",
      "title": "\u05e9\u05dc\u05d1 \u05e7\u05dc\u05d9\u05d8\u05d4",
      "default": 0
    },
    "preferences": {
      "type": "string",
      "title": "\u05d4\u05e2\u05d3\u05e4\u05d5\u05ea"
    },
    "constraints": {
      "type": "string",
      "title": "\u05d0\u05d9\u05dc\u05d5\u05e6\u05d9\u05dd"
    },
    "allowed_stations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u05e2\u05de\u05d3\u05d5\u05ea \u05de\u05d5\u05ea\u05e8\u05d5\u05ea"
    },
    "fixed_stations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "\u05e2\u05de\u05d3\u05d5\u05ea \u05e7\u05d1\u05d5\u05e2\u05d5\u05ea"
    },
    "phone": {
      "type": "string",
      "title": "\u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "user_id": {
      "type": "string",
      "title": "\u05de\u05e9\u05ea\u05de\u05e9 \u05de\u05e7\u05d5\u05e9\u05e8"
    }
  },
  "required": [
    "full_name",
    "email",
    "employee_id"
  ],
  "access": {
    "read": "all_authenticated",
    "create": "admin",
    "update": "admin",
    "delete": "admin"
  }
}