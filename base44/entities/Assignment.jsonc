{
  "name": "Assignment",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string",
      "title": "\u05ea\u05d5\u05db\u05e0\u05d9\u05ea"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "\u05ea\u05d0\u05e8\u05d9\u05da"
    },
    "day_of_week": {
      "type": "number",
      "title": "\u05d9\u05d5\u05dd \u05d1\u05e9\u05d1\u05d5\u05e2 (0=\u05e8\u05d0\u05e9\u05d5\u05df)"
    },
    "break_type": {
      "type": "string",
      "enum": [
        "big",
        "medium",
        "small"
      ],
      "title": "\u05e1\u05d5\u05d2 \u05d4\u05e4\u05e1\u05e7\u05d4"
    },
    "break_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05d4\u05e4\u05e1\u05e7\u05d4"
    },
    "start_time": {
      "type": "string",
      "title": "\u05e9\u05e2\u05ea \u05d4\u05ea\u05d7\u05dc\u05d4"
    },
    "end_time": {
      "type": "string",
      "title": "\u05e9\u05e2\u05ea \u05e1\u05d9\u05d5\u05dd"
    },
    "station_id": {
      "type": "string",
      "title": "\u05e2\u05de\u05d3\u05d4"
    },
    "station_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05e2\u05de\u05d3\u05d4"
    },
    "teacher_id": {
      "type": "string",
      "title": "\u05de\u05d5\u05e8\u05d4 \u05de\u05e9\u05d5\u05d1\u05e5"
    },
    "teacher_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05d5\u05e8\u05d4"
    },
    "source": {
      "type": "string",
      "enum": [
        "auto",
        "manual",
        "swap"
      ],
      "title": "\u05de\u05e7\u05d5\u05e8 \u05d4\u05e9\u05d9\u05d1\u05d5\u05e5",
      "default": "auto"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "confirmed",
        "completed",
        "missed",
        "swapped"
      ],
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1",
      "default": "scheduled"
    },
    "replacement_teacher_id": {
      "type": "string",
      "title": "\u05de\u05d7\u05dc\u05d9\u05e3"
    },
    "replacement_teacher_name": {
      "type": "string",
      "title": "\u05e9\u05dd \u05de\u05d7\u05dc\u05d9\u05e3"
    },
    "plan_status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "title": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05ea\u05d5\u05db\u05e0\u05d9\u05ea",
      "default": "draft"
    },
    "change_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "string"
          },
          "user": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "previous_teacher": {
            "type": "string"
          }
        }
      },
      "title": "\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d9\u05ea \u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd",
      "default": []
    }
  },
  "required": [
    "plan_id",
    "date",
    "break_type",
    "station_id"
  ],
  "access": {
    "read": "all_authenticated",
    "create": "admin",
    "update": "admin",
    "delete": "admin"
  }
}